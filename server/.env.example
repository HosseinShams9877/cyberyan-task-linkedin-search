# ---------------------------------------------------------------------------
# Local development configuration (copy to .env — .env is git-ignored).
# ---------------------------------------------------------------------------

# Database. The Prisma provider is derived from this URL at generate time:
#   file:...        -> sqlite   (local development)
#   postgres(ql):// -> postgresql (production / Neon)
#
# Local (SQLite, resolved relative to server/prisma/):
DATABASE_URL="file:./dev.db"
#
# Production example (Neon pooled connection string):
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Port for the standalone Express server (ignored on Vercel).
PORT=5000

# Comma-separated list of allowed browser origins. Empty = allow any origin.
# CORS_ORIGIN=http://localhost:5173

# Optional overrides for the seed script (defaults to ../data/300 user linkedin*).
# DATA_DIR=../data
# DATASET_FILE=../data/300 user linkedin.txt
